APP_NAME=Enterprise Decision Intelligence Platform
APP_VERSION=0.1.0
APP_ENVIRONMENT=local
APP_DEBUG=false
APP_API_V1_PREFIX=/api/v1
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
APP_DATABASE_URL=postgresql+psycopg://enterprise:enterprise@localhost:5432/decision_intelligence
APP_JWT_SECRET_KEY=change-me-in-production
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_REFRESH_TOKEN_EXPIRE_DAYS=7
APP_CELERY_BROKER_URL=redis://localhost:6379/0
APP_CELERY_RESULT_BACKEND=redis://localhost:6379/1
APP_LOG_LEVEL=INFO
